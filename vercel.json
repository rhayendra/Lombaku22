{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "{templates/**,static/**,database/**,routes/**,services/**}"
    }
  },
  "rewrites": [
    { "source": "/((?!static/).*)", "destination": "/api/index?__vpath=/$1" }
  ]
}
